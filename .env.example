# Database used by docker-compose.yml and the FastAPI app.
POSTGRES_USER=netops_admin
POSTGRES_PASSWORD=your_database_password
POSTGRES_DB=netops_hub
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
DATABASE_URL=postgresql://netops_admin:netops_password@localhost:5434/netops_hub

APP_NAME=NetHub-Ops
DEBUG=True
SECRET_KEY=your_secret_key


# SSH Network Automation 
DEFAULT_SSH_PORT=22
SSH_TIMEOUT=10
COMMAND_TIMEOUT=30

# Ping Configurations 
PING_TIMEOUT=2

# Backup_Configurations 
BACKUP_DIRECTORY=app/backups 


# ----------------------------------------------------------
# Optional Future Features
# ----------------------------------------------------------

# Telegram Bot
TELEGRAM_BOT_TOKEN=

# Email Notifications
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Webhook
WEBHOOK_SECRET=

# JWT Authentication
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256